# ==================================================
# KEYSTONE ENVIRONMENT CONFIGURATION EXAMPLE
# Copy this file to .env for local overrides (do not commit .env)
# ==================================================

# --------------------------------------------------
# BACKEND & DATABASE CONFIGURATION (Spring Boot / PostgreSQL)
# --------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/keystone_db
DB_USERNAME=postgres
DB_PASSWORD=
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# --------------------------------------------------
# JWT SECURITY CONFIGURATION
# Secrets must be a base64 encoded string or a long secret key (at least 256 bits / 32 chars)
# --------------------------------------------------
JWT_SECRET=your-base64-encoded-secret-here
JWT_EXPIRATION_MS=43200000

# --------------------------------------------------
# FRONTEND CONFIGURATION (Vite / React)
# --------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api
